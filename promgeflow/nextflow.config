// nextflow.config — entrypoint for proMGEflow runs from this directory.
// Loaded by the wrapper via `-c <this file>`. Layers:
//   params { ... }            pipeline defaults (override via -params-file or --foo on CLI)
//   global conda/trace blocks apply to every run
//   global mgexpose override  swap unpublished container for a conda env
//   profiles { ... }          container engine + executor selection

params {
    output_dir            = "./results"
    known_speci           = "unknown"
    recognise_marker_set  = "motus"
    prodigal_batch_size   = 10
    use_y_clusters        = true
}

// ---- global: conda support (used by `mgexpose`) ----
// The mgexpose container/conda override itself lives in hpc.config because
// `withName: mgexpose` selectors across files don't deep-merge reliably here
// — keeping all mgexpose directives in one block avoids that.
conda {
    enabled       = true
    useMamba      = true
    cacheDir      = System.getenv('CONDA_ENVS_DIR') ?: "${System.getenv('HOME')}/conda-envs"
    createTimeout = '1 h'
}

// ---- global: lightweight tracing ----
// One trace file per run, named with the run timestamp so reruns don't clobber.
def runTs = new java.util.Date().format('yyyyMMdd-HHmmss')
trace {
    enabled   = true
    file      = "${params.output_dir}/pipeline_trace_${runTs}.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

// ---- profiles ----
// Combine freely, e.g. `-profile singularity,slurm`.
profiles {
    standard {
        // local execution, no containers — quick smoke tests only.
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('HOME')}/.singularity_cache"
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    slurm {
        // Slurm executor + per-process resource tunings live in hpc.config.
        includeConfig 'hpc.config'
    }
}
