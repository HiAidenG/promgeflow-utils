// hpc.config — Slurm executor + per-process resource tunings for proMGEflow.
// Pulled in by the `slurm` profile in nextflow.config.

process {
    executor       = 'slurm'
    queue          = 'cpu-single'

    // Standard retry policy: bump cpus/memory/time on each attempt, up to 5 retries.
    // Slurm exit codes:
    //   137 = OOM-kill (SIGKILL),  140 = Slurm OOM,  143 = wall-time (SIGTERM)
    // Special cases:
    //   Integer.MAX_VALUE / null  = task never started (submit failure, controller down)
    //                               -> retry, since the cluster, not our code, is the problem
    errorStrategy  = {
        if ( task.exitStatus in [137, 140, 143] ) return 'retry'                  // OOM / wall-time
        if ( task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE )
            return task.attempt <= 5 ? 'retry' : 'finish'                          // submit failed
        return 'finish'                                                            // real error
    }
    maxRetries     = 5

    // Defaults if a process declares no label.
    // Right-sized down: most observed proMGEflow tasks use <1 GB and <30 min;
    // the heavy hitters (eggnog, linclust) have dedicated withName overrides.
    cpus   = 1
    memory = { 2.GB  * task.attempt }
    time   = { 30.m  * task.attempt }

    // ---- generic label buckets ----
    withLabel: process_low {
        cpus   = 1
        memory = { 2.GB  * task.attempt }
        time   = { 30.m  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 2
        memory = { 8.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withLabel: process_long {
        time   = { 1.d   * task.attempt }
    }

    // ---- per-process tuning based on observed trace data ----
    //
    // Routing: short single-genome tasks go to 'devel' for faster scheduling
    // turnaround; on retry they get promoted to 'cpu-single' with a longer time
    // budget — safer than running out the clock on devel.

    // eggnog-mapper: ~6.8 GB peak rss, ~7.4 effective threads of 8, ~33 min runtime.
    // Too long for devel; goes straight to cpu-single.
    withName: eggnog_mapper {
        queue  = 'cpu-single'
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }

    // linclust on the pangenome ref:
    //   - small specI clusters: trivial, sub-second.
    //   - big species (E. coli etc, 1000s of genomes, 10M+ genes): the ONE step
    //     that can blow up. Generous default, retry-doubling if it OOMs.
    //   - no fat-node partition on this cluster, so request hard on cpu-single.
    withName: linclust {
        queue  = 'cpu-single'
        cpus   = 16
        memory = { 64.GB * task.attempt }   // 64 -> 128 -> 192 -> 256 -> 320 GB
        time   = { 8.h   * task.attempt }   // 8 -> 16 -> 24 h ...
    }

    // recognise + mapseq: SINGLE-THREADED, ~1.5 min, ~1.9 GB rss.
    withName: 'recognise|recognise_genome' {
        queue  = { task.attempt == 1 ? 'devel' : 'cpu-single' }
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { task.attempt == 1 ? 30.m : 2.h * task.attempt }
    }

    // recombinase_scan: ~25 sec, ~250 MB peak.
    withName: recombinase_scan {
        queue  = { task.attempt == 1 ? 'devel' : 'cpu-single' }
        cpus   = 2
        memory = { 1.GB  * task.attempt }
        time   = { task.attempt == 1 ? 30.m : 2.h * task.attempt }
    }

    // macsyfinder: ~30 sec, ~500 MB peak.
    withName: macsyfinder {
        queue  = { task.attempt == 1 ? 'devel' : 'cpu-single' }
        cpus   = 2
        memory = { 2.GB  * task.attempt }
        time   = { task.attempt == 1 ? 30.m : 2.h * task.attempt }
    }

    // mgexpose: ~5 MB rss, ~30 sec, single-threaded.
    // ghcr.io/{cschu,grp-bork}/mgexpose:v3.8.0 is unpublished and mgexpose
    // isn't on Bioconda, so we null out the script-level container directive
    // and run via a conda env (pip-installs mgexpose from PyPI). The wrapper
    // exports MGEXPOSE_ENV_YAML; falls back to mgexpose.yml in CWD if unset
    // so this block never has a null `conda` value that would cause Nextflow
    // to silently drop the surrounding selector during config parsing.
    withName: mgexpose {
        container    = ''
        conda        = System.getenv('MGEXPOSE_ENV_YAML') ?: 'mgexpose.yml'
        beforeScript = 'module load devel/miniforge'
        queue        = { task.attempt == 1 ? 'devel' : 'cpu-single' }
        cpus         = 1
        memory       = { 1.GB  * task.attempt }
        time         = { task.attempt == 1 ? 15.m : 1.h * task.attempt }
    }

    // tiny tasks — mostly file plumbing, <100 MB and <10 sec each.
    withName: 'pangenome_summary|publish_gene_annotations|publish_recombinase_scan|get_db_seqs' {
        queue  = { task.attempt == 1 ? 'devel' : 'cpu-single' }
        cpus   = 1
        memory = { 1.GB  * task.attempt }
        time   = { task.attempt == 1 ? 15.m : 1.h * task.attempt }
    }

    // ---- publishDir ----
    // Switch ALL publishing to hardlinks (saves space on scratch).
    // Modes: copy | link | symlink | rellink | move (move BREAKS -resume).
    publishDir = [
        path: { "${params.output_dir}" },
        mode: 'link',
        overwrite: true,
        saveAs: { fn -> fn }
    ]
}

// ---- scheduler etiquette ----
// Cap how many jobs nextflow keeps in flight, and how fast it submits them.
executor {
    queueSize         = 50
    submitRateLimit   = '10/min'
    pollInterval      = '30 sec'
    dumpInterval      = '5 min'

    // Slurm sometimes drops calls (controller restarts, network hiccups).
    queueStatInterval = '2 min'
    exitReadTimeout   = '15 min'
    killBatchSize     = 50
}
